// MANDI-SETU — Prisma schema.  OWNER: R1 ONLY.
//
// Change protocol: append a CONTRACT entry to docs/BLOCKERS.md. Do not edit this file
// unless you are R1. Frozen at H4 except for additive, nullable columns.
//
// CONVENTIONS (enforced, see CLAUDE.md §2):
//   * Money   -> Int, unit = paise, field name ends `Paise`. Ceiling per field is
//                2^31 paise = Rs 2.14 crore, far above any single farm transaction.
//                Cumulative totals are aggregated in SQL and returned as strings.
//   * Quantity-> Int, unit = kilograms, field name ends `Kg`. 1 quintal = 100 kg.
//                Never store fractional quantities.
//   * Time    -> DateTime (UTC). Display in IST at the render edge only.
//   * P1 models are declared now so no migration is needed later, but no UI is built
//     for them in the 3-day window.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA  (seeded by prisma/seed/00_reference.ts — R1)
// ─────────────────────────────────────────────────────────────────────────────

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  nameMr    String   @map("name_mr")
  stateCode String   @default("MH") @map("state_code")
  lat       Float
  lon       Float
  markets   Market[]
  farmers   Farmer[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("district")
}

/// An APMC mandi or other physical assembly point.
model Market {
  id          String     @id @default(cuid())
  apmcCode    String?    @unique @map("apmc_code")
  name        String
  nameMr      String     @map("name_mr")
  districtId  String     @map("district_id")
  district    District   @relation(fields: [districtId], references: [id])
  lat         Float
  lon         Float
  /// Whether this mandi is integrated with eNAM. Affects channel recommendations.
  isEnam      Boolean    @default(false) @map("is_enam")
  priceObs    PriceObs[]
  forecasts   Forecast[]
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([districtId])
  @@map("market")
}

model Commodity {
  id           String       @id @default(cuid())
  /// Agmarknet commodity name, kept verbatim so ingestion can join on it.
  name         String       @unique
  nameMr       String       @map("name_mr")
  /// Free-form group: VEGETABLE | CEREAL | PULSE | OILSEED | FRUIT
  group        String
  /// Days the crop can be held in ordinary conditions before quality loss begins.
  shelfLifeDays Int         @map("shelf_life_days")
  /// Percent of mass lost per day of storage, in basis points (250 = 2.50%/day).
  spoilageBpsPerDay Int     @map("spoilage_bps_per_day")
  priceObs     PriceObs[]
  forecasts    Forecast[]
  lots         Lot[]
  demands      Demand[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("commodity")
}

/// Static logistics + storage cost table. Seeded, not computed, for the 3-day build.
/// Replacing this with a live rate API is a P2 item; the interface stays the same.
model CostTable {
  id                    String   @id @default(cuid())
  districtId            String   @map("district_id")
  /// Paise per kg per km of road transport.
  transportPaisePerKgKm Int      @map("transport_paise_per_kg_km")
  /// Paise per kg per day of ordinary (non-cold) storage.
  storagePaisePerKgDay  Int      @map("storage_paise_per_kg_day")
  /// Paise per kg per day of cold storage.
  coldPaisePerKgDay     Int      @map("cold_paise_per_kg_day")
  /// Annualised pledge-finance rate in basis points (1200 = 12.00% p.a.).
  financeBpsPerAnnum    Int      @map("finance_bps_per_annum")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([districtId])
  @@map("cost_table")
}

model Warehouse {
  id           String   @id @default(cuid())
  name         String
  districtId   String   @map("district_id")
  lat          Float
  lon          Float
  capacityKg   Int      @map("capacity_kg")
  isCold       Boolean  @default(false) @map("is_cold")
  /// WDRA-registered warehouses can issue an electronic negotiable warehouse receipt.
  isWdra       Boolean  @default(false) @map("is_wdra")
  ratePaisePerKgDay Int @map("rate_paise_per_kg_day")
  lots         Lot[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([districtId])
  @@map("warehouse")
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY  (R1)
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  FARMER
  BUYER
  FPO_ADMIN
  ADMIN
}

/// NEVER store Aadhaar. Phone is the identifier. See CLAUDE.md I8.
model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String
  nameMr    String?   @map("name_mr")
  role      UserRole
  /// bcrypt hash of a 4-digit PIN. Null until the user sets one.
  pinHash   String?   @map("pin_hash")
  /// 'mr' | 'en'
  locale    String    @default("mr")
  farmer    Farmer?
  buyer     Buyer?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("app_user")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_code")
}

model Farmer {
  id           String           @id @default(cuid())
  userId       String           @unique @map("user_id")
  user         User             @relation(fields: [userId], references: [id])
  districtId   String           @map("district_id")
  district     District         @relation(fields: [districtId], references: [id])
  village      String
  /// Land holding in are (1 hectare = 100 are). Integer, no fractions.
  landAre      Int              @map("land_are")
  lots         Lot[]
  memberships  FpoMembership[]
  consents     PoolConsent[]
  ledger       RealisationLedger[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([districtId])
  @@map("farmer")
}

model Fpo {
  id          String          @id @default(cuid())
  name        String
  nameMr      String          @map("name_mr")
  districtId  String          @map("district_id")
  /// Registration number, if any. Displayed in the buyer-facing credential card.
  regNo       String?         @map("reg_no")
  members     FpoMembership[]
  pools       Pool[]
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("fpo")
}

model FpoMembership {
  id       String @id @default(cuid())
  fpoId    String @map("fpo_id")
  fpo      Fpo    @relation(fields: [fpoId], references: [id])
  farmerId String @map("farmer_id")
  farmer   Farmer @relation(fields: [farmerId], references: [id])
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([fpoId, farmerId])
  @@map("fpo_membership")
}

enum BuyerTier {
  /// T0: self-declared, phone verified only. Cannot receive escrow.
  T0_UNVERIFIED
  /// T1: GSTIN present and format-valid.
  T1_REGISTERED
  /// T2: T1 + at least 3 settled transactions on platform.
  T2_TRANSACTED
  /// T3: T2 + reliability score above threshold, zero upheld disputes.
  T3_TRUSTED
}

model Buyer {
  id            String     @id @default(cuid())
  userId        String     @unique @map("user_id")
  user          User       @relation(fields: [userId], references: [id])
  legalName     String     @map("legal_name")
  /// Format-validated only. We never claim to have verified it with GSTN.
  gstin         String?
  kind          String     // TRADER | PROCESSOR | INSTITUTIONAL | EXPORTER | RETAILER
  districtId    String     @map("district_id")
  tier          BuyerTier  @default(T0_UNVERIFIED)
  /// 0-1000. Computed by src/lib/domain/reliability.ts. Never hand-edited.
  reliability   Int        @default(500)
  demands       Demand[]
  offers        Offer[]
  transactions  Transaction[]
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([districtId])
  @@map("buyer")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRICE INTELLIGENCE  (R2)
// ─────────────────────────────────────────────────────────────────────────────

enum ObsSource {
  /// Ingested from Agmarknet / data.gov.in.
  AGMARKNET
  /// Ingested from MSAMB.
  MSAMB
  /// Filled by the imputation model from neighbouring markets.
  IMPUTED
  /// Generated. MUST be badged in the UI. See CLAUDE.md I6.
  SYNTHETIC
}

model PriceObs {
  id           String    @id @default(cuid())
  commodityId  String    @map("commodity_id")
  commodity    Commodity @relation(fields: [commodityId], references: [id])
  marketId     String    @map("market_id")
  market       Market    @relation(fields: [marketId], references: [id])
  obsDate      DateTime  @map("obs_date") @db.Date
  minPaisePerQtl   Int   @map("min_paise_per_qtl")
  maxPaisePerQtl   Int   @map("max_paise_per_qtl")
  modalPaisePerQtl Int   @map("modal_paise_per_qtl")
  /// Reported arrivals in kg. Null when the source omits it (common).
  arrivalKg    Int?      @map("arrival_kg")
  source       ObsSource
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([commodityId, marketId, obsDate])
  @@index([commodityId, obsDate])
  @@index([marketId, obsDate])
  @@map("price_obs")
}

/// One row per (commodity, market, run, horizon day). Quantile forecast.
model Forecast {
  id           String    @id @default(cuid())
  commodityId  String    @map("commodity_id")
  commodity    Commodity @relation(fields: [commodityId], references: [id])
  marketId     String    @map("market_id")
  market       Market    @relation(fields: [marketId], references: [id])
  /// Timestamp of the model run that produced this row.
  runAt        DateTime  @map("run_at")
  targetDate   DateTime  @map("target_date") @db.Date
  horizonDays  Int       @map("horizon_days")
  p10PaisePerQtl Int     @map("p10_paise_per_qtl")
  p50PaisePerQtl Int     @map("p50_paise_per_qtl")
  p90PaisePerQtl Int     @map("p90_paise_per_qtl")
  /// e.g. 'lgbm-quantile-v3', 'seasonal-naive'. Shown in the model card.
  model        String
  /// Mean absolute scaled error on the backtest window. < 1.0 beats naive.
  mase         Float?
  /// Empirical coverage of the p10-p90 band on the backtest, 0-1.
  coverage     Float?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([commodityId, marketId, runAt, targetDate])
  @@index([commodityId, marketId, targetDate])
  @@map("forecast")
}

enum WindowAction {
  SELL_NOW
  /// Sell today at a different nearby mandi. PS: "nearby markets".
  SELL_ELSEWHERE
  HOLD
  SPLIT
  /// Band too wide, or data too thin, to advise. See CLAUDE.md I4.
  NO_ADVICE
}

/// A recommendation we actually showed a farmer. Stored so we can measure ourselves
/// honestly afterwards: did the farmer follow it, and did following it pay?
model Recommendation {
  id             String       @id @default(cuid())
  farmerId       String?      @map("farmer_id")
  commodityId    String       @map("commodity_id")
  marketId       String       @map("market_id")
  qtyKg          Int          @map("qty_kg")
  action         WindowAction
  holdDays       Int          @map("hold_days")
  expectedGainPaisePerQtl Int @map("expected_gain_paise_per_qtl")
  /// 'HIGH' | 'MEDIUM' | 'LOW'
  confidence     String
  /// (p90-p10)/p50 in basis points. Drives the NO_ADVICE threshold.
  bandBps        Int          @map("band_bps")
  /// Full request + response payload, for audit and for the model card.
  payload        Json
  shownAt        DateTime     @default(now()) @map("shown_at")
  /// Set later by R3 when a transaction closes, so we can score ourselves.
  followed       Boolean?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([farmerId, shownAt])
  @@map("recommendation")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOTS, GRADING, AGGREGATION  (R3)
// ─────────────────────────────────────────────────────────────────────────────

enum LotStatus {
  DRAFT
  LISTED
  POOLED
  OFFER_PENDING
  COMMITTED
  DELIVERED
  SETTLED
  WITHDRAWN
}

model Lot {
  id           String     @id @default(cuid())
  farmerId     String     @map("farmer_id")
  farmer       Farmer     @relation(fields: [farmerId], references: [id])
  commodityId  String     @map("commodity_id")
  commodity    Commodity  @relation(fields: [commodityId], references: [id])
  qtyKg        Int        @map("qty_kg")
  harvestDate  DateTime   @map("harvest_date") @db.Date
  status       LotStatus  @default(DRAFT)
  /// Where it is physically sitting. Null = on farm.
  warehouseId  String?    @map("warehouse_id")
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  /// Farmer's reserve price. Offers below this are auto-flagged, never auto-rejected.
  reservePaisePerQtl Int? @map("reserve_paise_per_qtl")
  assay        GradeAssay?
  poolMember   PoolMember?
  offers       Offer[]
  transactions Transaction[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([farmerId, status])
  @@index([commodityId, status])
  @@map("lot")
}

enum Grade {
  A
  B
  C
  /// The grader abstained: inputs insufficient or contradictory. See CLAUDE.md I4.
  UNGRADED
}

model GradeAssay {
  id        String   @id @default(cuid())
  lotId     String   @unique @map("lot_id")
  lot       Lot      @relation(fields: [lotId], references: [id])
  grade     Grade
  /// 0-1000 composite quality score. Drives the fair-split weights.
  score     Int
  /// Per-dimension raw inputs, e.g. {"sizeMm":55,"moisturePct":11,"rotPct":2}.
  dims      Json
  /// 'SELF_DECLARED' | 'RULE_ENGINE' | 'CV_MODEL' | 'FPO_INSPECTOR'
  method    String
  /// True when the model declined to assign a grade.
  abstained Boolean  @default(false)
  /// Free-text reason shown to the farmer when abstained.
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("grade_assay")
}

enum PoolStatus {
  FORMING
  CONSENT_PENDING
  READY
  LISTED
  COMMITTED
  SETTLED
  CANCELLED
}

/// An FPO aggregation: many farmers' lots sold as one commercial unit.
model Pool {
  id          String       @id @default(cuid())
  fpoId       String       @map("fpo_id")
  fpo         Fpo          @relation(fields: [fpoId], references: [id])
  commodityId String       @map("commodity_id")
  status      PoolStatus   @default(FORMING)
  totalQtyKg  Int          @default(0) @map("total_qty_kg")
  /// Weighted average score of member lots, 0-1000.
  avgScore    Int          @default(0) @map("avg_score")
  members     PoolMember[]
  consents    PoolConsent[]
  offers      Offer[]
  transactions Transaction[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([fpoId, status])
  @@map("pool")
}

model PoolMember {
  id       String @id @default(cuid())
  poolId   String @map("pool_id")
  pool     Pool   @relation(fields: [poolId], references: [id])
  lotId    String @unique @map("lot_id")
  lot      Lot    @relation(fields: [lotId], references: [id])
  qtyKg    Int    @map("qty_kg")
  /// Snapshot of the lot's score at pooling time, so later regrades cannot
  /// retroactively change an agreed split.
  scoreAtPool Int @map("score_at_pool")
  /// Share of pool proceeds in basis points. Sum over members == 10000.
  shareBps Int   @map("share_bps")

  @@index([poolId])
  @@map("pool_member")
}

/// Consent must be recorded BEFORE the pool can leave CONSENT_PENDING.
/// Consenting to a split after the money arrives is not consent.
model PoolConsent {
  id         String   @id @default(cuid())
  poolId     String   @map("pool_id")
  pool       Pool     @relation(fields: [poolId], references: [id])
  farmerId   String   @map("farmer_id")
  farmer     Farmer   @relation(fields: [farmerId], references: [id])
  /// The exact shareBps the farmer agreed to. Compared against PoolMember at payout.
  agreedShareBps Int  @map("agreed_share_bps")
  accepted   Boolean
  /// Channel through which consent was captured: APP | IVR | SMS | FPO_DESK
  channel    String
  decidedAt  DateTime @default(now()) @map("decided_at")

  @@unique([poolId, farmerId])
  @@map("pool_consent")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEMAND, MATCHING, OFFERS, SETTLEMENT  (R3)
// ─────────────────────────────────────────────────────────────────────────────

model Demand {
  id            String    @id @default(cuid())
  buyerId       String    @map("buyer_id")
  buyer         Buyer     @relation(fields: [buyerId], references: [id])
  commodityId   String    @map("commodity_id")
  commodity     Commodity @relation(fields: [commodityId], references: [id])
  qtyKg         Int       @map("qty_kg")
  minGrade      Grade     @default(C) @map("min_grade")
  indicativePaisePerQtl Int @map("indicative_paise_per_qtl")
  deliverBy     DateTime  @map("deliver_by") @db.Date
  /// Where the buyer wants delivery.
  districtId    String    @map("district_id")
  /// Free-text quality spec shown to farmers verbatim.
  qualitySpec   String?   @map("quality_spec")
  active        Boolean   @default(true)
  offers        Offer[]
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([commodityId, active])
  @@map("demand")
}

enum OfferStatus {
  OPEN
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

model Offer {
  id            String      @id @default(cuid())
  demandId      String      @map("demand_id")
  demand        Demand      @relation(fields: [demandId], references: [id])
  buyerId       String      @map("buyer_id")
  buyer         Buyer       @relation(fields: [buyerId], references: [id])
  /// Exactly one of lotId / poolId is set. Enforced in domain code.
  lotId         String?     @map("lot_id")
  lot           Lot?        @relation(fields: [lotId], references: [id])
  poolId        String?     @map("pool_id")
  pool          Pool?       @relation(fields: [poolId], references: [id])
  qtyKg         Int         @map("qty_kg")
  pricePaisePerQtl Int      @map("price_paise_per_qtl")
  status        OfferStatus @default(OPEN)
  /// Set when status = COUNTERED, pointing at the replacement offer.
  counterOfId   String?     @map("counter_of_id")
  expiresAt     DateTime    @map("expires_at")
  transaction   Transaction?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([demandId, status])
  @@index([lotId])
  @@map("offer")
}

/// Escrow state machine. Transitions ONLY via src/lib/domain/escrow.ts (I9).
///   AGREED -> ESCROW_FUNDED -> IN_TRANSIT -> DELIVERED -> QC_PASSED -> RELEASED
///   any of the above -> DISPUTED -> (RELEASED | REFUNDED)
///   AGREED -> CANCELLED
enum TxStatus {
  AGREED
  ESCROW_FUNDED
  IN_TRANSIT
  DELIVERED
  QC_PASSED
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

model Transaction {
  id            String        @id @default(cuid())
  offerId       String        @unique @map("offer_id")
  offer         Offer         @relation(fields: [offerId], references: [id])
  buyerId       String        @map("buyer_id")
  buyer         Buyer         @relation(fields: [buyerId], references: [id])
  lotId         String?       @map("lot_id")
  lot           Lot?          @relation(fields: [lotId], references: [id])
  poolId        String?       @map("pool_id")
  pool          Pool?         @relation(fields: [poolId], references: [id])
  qtyKg         Int           @map("qty_kg")
  pricePaisePerQtl Int        @map("price_paise_per_qtl")
  /// qtyKg/100 * pricePaisePerQtl, computed once and stored. Never recomputed on read.
  grossPaise    Int           @map("gross_paise")
  /// Platform fee. Zero for the demo; the field exists so the model is honest.
  feePaise      Int           @default(0) @map("fee_paise")
  transportPaise Int          @default(0) @map("transport_paise")
  netToSellerPaise Int        @map("net_to_seller_paise")
  status        TxStatus      @default(AGREED)
  /// Client-supplied idempotency key on the mutation that created this row.
  idemKey       String        @unique @map("idem_key")
  events        EscrowEvent[]
  dispute       Dispute?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([buyerId, status])
  @@map("transaction")
}

model EscrowEvent {
  id        String      @id @default(cuid())
  txId      String      @map("tx_id")
  tx        Transaction @relation(fields: [txId], references: [id])
  fromStatus TxStatus   @map("from_status")
  toStatus  TxStatus    @map("to_status")
  /// User id that caused the transition, or 'SYSTEM'.
  actorId   String      @map("actor_id")
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([txId, createdAt])
  @@map("escrow_event")
}

enum DisputeStage {
  RAISED
  BUYER_RESPONDED
  EVIDENCE_REVIEW
  RESOLVED_SELLER
  RESOLVED_BUYER
  RESOLVED_SPLIT
  ESCALATED
}

model Dispute {
  id        String       @id @default(cuid())
  txId      String       @unique @map("tx_id")
  tx        Transaction  @relation(fields: [txId], references: [id])
  raisedBy  String       @map("raised_by")
  /// QUALITY | QUANTITY | PAYMENT_DELAY | NON_DELIVERY | OTHER
  reason    String
  stage     DisputeStage @default(RAISED)
  /// Deadline for the counterparty to respond. Silence past this favours the raiser.
  respondBy DateTime     @map("respond_by")
  evidence  Json?
  outcome   String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("dispute")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPEND-ONLY RECORDS  (R3).  No UPDATE. No DELETE. Ever. (I3)
// ─────────────────────────────────────────────────────────────────────────────

/// The impact number. One row per settled sale, recording what the farmer actually
/// realised versus the harvest-day benchmark price for the same commodity/market.
model RealisationLedger {
  id            String   @id @default(cuid())
  farmerId      String   @map("farmer_id")
  farmer        Farmer   @relation(fields: [farmerId], references: [id])
  txId          String   @map("tx_id")
  commodityId   String   @map("commodity_id")
  marketId      String   @map("market_id")
  qtyKg         Int      @map("qty_kg")
  /// Modal price on the harvest date at the farmer's nearest mandi. The counterfactual.
  benchmarkPaisePerQtl Int @map("benchmark_paise_per_qtl")
  /// How the counterfactual was computed, so a challenged G can be recomputed under an
  /// alternative method. 'HARVEST_DAY_MODAL_HOME_MANDI' is the only method in v0.
  baselineMethod String @default("HARVEST_DAY_MODAL_HOME_MANDI") @map("baseline_method")
  realisedPaisePerQtl  Int @map("realised_paise_per_qtl")
  /// (realised - benchmark) * qtyKg/100, net of storage/transport/finance actually paid.
  deltaPaise    Int      @map("delta_paise")
  /// Days the lot was held between harvest and sale.
  heldDays      Int      @map("held_days")
  /// Whether a MANDI-SETU recommendation was on record and followed.
  recommendationId String? @map("recommendation_id")
  seq           Int      @unique @default(autoincrement())
  prevHash      String   @map("prev_hash")
  hash          String   @unique
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([farmerId, createdAt])
  @@map("realisation_ledger")
}

/// Hash-chained audit trail of every state-changing action. See playbook Ch 08 for
/// why this is a chained table and deliberately NOT a blockchain.
model AuditLog {
  id        String   @id @default(cuid())
  seq       Int      @unique @default(autoincrement())
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  /// Before/after diff, PII-redacted at write time.
  payload   Json
  prevHash  String   @map("prev_hash")
  hash      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// P1 — declared, not built in the 3-day window
// ─────────────────────────────────────────────────────────────────────────────

/// Electronic negotiable warehouse receipt. Enables pledge finance so the farmer
/// can wait without borrowing informally. The whole point of the "waiting product".
model Enwr {
  id           String    @id @default(cuid())
  lotId        String    @unique @map("lot_id")
  warehouseId  String    @map("warehouse_id")
  receiptNo    String    @unique @map("receipt_no")
  qtyKg        Int       @map("qty_kg")
  grade        Grade
  /// Assessed collateral value at deposit.
  valuePaise   Int       @map("value_paise")
  issuedAt     DateTime  @map("issued_at")
  pledge       Pledge?

  @@map("enwr")
}

/// GUARDRAIL (playbook Ch 13): an advance is only offered when the expected gain
/// from holding exceeds the finance cost, and repayment is automatic from sale
/// proceeds so the loan cannot roll. Enforced in domain code, not just documented.
model Pledge {
  id             String   @id @default(cuid())
  enwrId         String   @unique @map("enwr_id")
  enwr           Enwr     @relation(fields: [enwrId], references: [id])
  advancePaise   Int      @map("advance_paise")
  rateBpsPerAnnum Int     @map("rate_bps_per_annum")
  /// Expected gain from holding at the time of advance. Must exceed financeCostPaise.
  expectedGainPaise Int   @map("expected_gain_paise")
  financeCostPaise  Int   @map("finance_cost_paise")
  /// AUTO_FROM_PROCEEDS is the only supported mode. No manual repayment, no rollover.
  repaymentMode  String   @default("AUTO_FROM_PROCEEDS") @map("repayment_mode")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("pledge")
}
