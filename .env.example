# MANDI-SETU — environment template
#
# OWNER: Kartik (task K0).  Copy to `.env` and fill in.  `.env` is gitignored.
#
# I10 — NO SECRETS IN GIT.  Only this template is committed, and every secret value in it
# is empty.  If a real secret ever lands in a commit, ROTATE IT — deleting the line in a
# follow-up commit does not remove it from history; `git log -p` finds the old blob in
# five seconds.
#
# I7 — the API makes ZERO live external network calls in a request path.  DATA_GOV_IN_API_KEY
# below is used only by the offline `ingest/` CLI, which Kartik runs by hand and which writes
# CSVs into `ingest/data/`.  Nothing in `api/` reads it.

# ── Runtime ────────────────────────────────────────────────────────────────────────────
# ENV gates every dev affordance below.  Must be exactly "production" on the EC2 box.
ENV="development"
LOG_LEVEL="info"

# ── Database ──────────────────────────────────────────────────────────────────────────
# SQLAlchemy 2.0 async needs the +asyncpg driver.  Host `db` is the docker-compose service
# name; use localhost only when running the API outside compose.
# Postgres port 5432 is NEVER published to the host on the deploy box — the API reaches it
# on the docker network.  See 08_DEVOPS_AND_DEPLOY.md.
DATABASE_URL="postgresql+asyncpg://mandi:mandi_dev_only@db:5432/mandi"
POSTGRES_USER="mandi"
POSTGRES_PASSWORD="mandi_dev_only"
POSTGRES_DB="mandi"

# ── Auth ──────────────────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty here.  A committed JWT secret means every token in the system is forgeable.
JWT_SECRET=""
JWT_TTL_HOURS="72"

# I15 — OTPs come from `secrets`, never `random`.  There is no fixed dev OTP: when
# DEV_OTP_ECHO is on, the real generated code is returned in the response body so you can
# log in without SMS.  Gated on BOTH this flag AND ENV != "production" (two conditions,
# because one of them will eventually be set wrong).
DEV_OTP_ECHO="true"

# Rate limits — without these the six-digit OTP space is brute-forceable in minutes.
OTP_MAX_REQUESTS_PER_PHONE="3"
OTP_REQUEST_WINDOW_MINUTES="10"
OTP_MAX_VERIFY_ATTEMPTS="5"

# ── Decision engine — Nilesh (L0) ─────────────────────────────────────────────────────
# I6 — the model may refuse.  These are the refusal thresholds and they live here, in
# config, not inline in a function body.  A judge may ask "why 35%?" and the answer must
# be "it is a tuned threshold, here is the value, here is the coverage it was tuned
# against."  A hardcoded 0.35 buried in an `if` is not a passing answer.
NO_ADVICE_BAND_BPS="3500"          # band wider than 35% of spot -> BAND_TOO_WIDE
NO_ADVICE_MIN_HISTORY_ROWS="180"   # fewer rows for this (commodity, market) -> INSUFFICIENT_HISTORY
NO_ADVICE_STALE_DAYS="7"           # latest observation older than this -> STALE_DATA
MIN_GAIN_PAISE_PER_QTL="3000"      # gain below this after costs -> GAIN_BELOW_COST

# Correlation coefficient used when aggregating downside across the hold window.
WINDOW_DEFAULT_RHO_BPS="3500"

# ── Model — Nikhil (N5) ───────────────────────────────────────────────────────────────
# The LightGBM models run IN-PROCESS inside the FastAPI worker.  There is no separate ML
# service and no HTTP hop.  Pickles are committed under this directory (N7) so the deploy
# box never has to train.  Loaded once at startup via `lifespan`, never per request.
MODEL_DIR="app/ml/models"

# ── Data acquisition — Kartik, offline only (K1) ──────────────────────────────────────
# Used by `python -m ingest.<source>` on Kartik's laptop.  Never read by the API.
DATA_GOV_IN_API_KEY=""

# ── App (React Native CLI) ────────────────────────────────────────────────────────────
# NOTHING HERE IS READ BY THE APP.  React Native CLI has no built-in env injection — there
# is no EXPO_PUBLIC_* equivalent.  The app's API base URL lives in a committed constants
# file, `app/src/config.ts`, owned by Pranay (P0).  See 12_STACK.md §7.2.
#
# The values below are FYI for whoever is editing that file:
#   Android emulator     http://10.0.2.2:8000/api/v1      <- NOT localhost; that is the emulator itself
#   Real phone, same wifi http://<your-laptop-LAN-ip>:8000/api/v1
#   Deployed             http://<ec2-host>/api/v1
#
# Android 9+ blocks cleartext HTTP.  Every one of those URLs also needs the domain listed in
# android/app/src/main/res/xml/network_security_config.xml — 12_STACK.md §7.3.  Without it
# the app fails with a network error that looks exactly like the API being down.
#
# The app holds no secrets.  Auth is a JWT the server issues at runtime.
