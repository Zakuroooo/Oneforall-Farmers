# MANDI-SETU environment template.  OWNER: R1.
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# If a real secret ever lands in git history, tell R1 immediately and rotate it —
# deleting the line in a later commit does not remove it from history.

# ── Database ────────────────────────────────────────────────────────────────
# Local (docker compose). Note port 5433.
DATABASE_URL="postgresql://mandi:mandi_dev_only@localhost:5433/mandi?schema=public"
# Production: Neon connection string with ?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in hours.
AUTH_SESSION_HOURS="72"
# When true, /api/auth/otp/request returns the OTP in the response so the team can
# log in without SMS. MUST be false in production. Guarded by NODE_ENV as well.
DEV_OTP_ECHO="true"
# Fixed OTP accepted in development only. Six digits.
DEV_OTP_CODE="465931"

# ── ML service ──────────────────────────────────────────────────────────────
ML_BASE_URL="http://localhost:8000"
# Shared secret in the x-ml-key header. The ML service must not be world-callable
# even in the demo — it is an unauthenticated compute endpoint otherwise.
ML_API_KEY=""

# ── Behaviour switches (read by domain code, not hardcoded) ─────────────────
# Forecast band width in bps above which the optimiser returns NO_ADVICE. (I4)
WINDOW_NO_ADVICE_BAND_BPS="2500"
# Minimum expected gain in paise/quintal before we suggest HOLD at all.
WINDOW_MIN_GAIN_PAISE_PER_QTL="3000"
# Default risk aversion when the farmer has not set one. 0=risk-neutral, 1=certainty-seeking.
WINDOW_DEFAULT_RHO="0.35"

# ── Optional data sources (R2). Absence must degrade gracefully, never crash. ─
# data.gov.in API key — free registration. Used by the OFFLINE ingestion job only.
# The demo never calls this at runtime. (I5)
DATA_GOV_IN_API_KEY=""

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Never log phone numbers, OTPs, or full payloads. See docs/02_SECURITY_AND_QUALITY.md.
